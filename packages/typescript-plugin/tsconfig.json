{
  "compilerOptions": {
    "target": "es2017",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "declaration": true,
    "outDir": "./dist",
    "sourceMap": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}
