{
  "name": "@ts-type-explorer/api",
  "type": "module",
  "version": "0.4.0",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@volar/language-core": "latest",
    "@volar/typescript": "latest",
    "@vue/language-core": "latest",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
