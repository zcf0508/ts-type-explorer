{
  "name": "ts-type-explorer",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -C packages/api run build && pnpm -C packages/typescript-plugin run build",
    "build:vscode": "pnpm run build && pnpm -C packages/typescript-explorer-vscode run build",
    "package": "pnpm run build && pnpm -C packages/typescript-explorer-vscode run package",
    "test": "mocha",
    "test:vscode": "wdio run ./wdio.conf.ts",
    "baseline-accept": "ts-node ./scripts/acceptBaselines.ts",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "release": "bumpp -r",
    "wdio": "wdio run ./wdio.conf.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.3.0",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/material": "^5.10.13",
    "@ts-type-explorer/api": "workspace:*",
    "@ts-type-explorer/typescript-plugin": "workspace:*",
    "@types/fs-extra": "^9.0.13",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.8.0",
    "@types/react": "^18.0.24",
    "@wdio/cli": "8.0.15",
    "@wdio/local-runner": "8.0.15",
    "@wdio/mocha-framework": "8.0.14",
    "@wdio/spec-reporter": "8.0.14",
    "@wdio/types": "8.0.14",
    "bumpp": "^10.0.3",
    "chromedriver": "latest",
    "eslint": "^9.10.0",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "lint-staged": "^13.0.3",
    "mocha": "^10.0.0",
    "ts-node": "^10.9.1",
    "typescript": "catalog:",
    "wdio-vscode-service": "5.2.3",
    "webdriverio": "8.0.15"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.0.24",
      "webdriverio": "8.0.15"
    }
  }
}
